# Netlify security headers (this file is read by Netlify at deploy time).
# CSP notes:
# - script-src allows only same-origin + inline scripts (every page uses inline JS
#   and onclick handlers, so 'unsafe-inline' is required; no external script hosts
#   are permitted at all).
# - frame-src lists the only third parties allowed to render inside the site:
#   Zeffy (donations/tuition/registration), JotForm (enrollment signing),
#   YouTube nocookie (the About Us story video).
# - img-src allows learn24.dc.gov for the hotlinked Learn24 sponsor logo.
# If you add a new embed or external resource, add its origin here or the
# browser will block it.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://learn24.dc.gov; frame-src https://www.zeffy.com https://www.jotform.com https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
